<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/settings_scroll"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:fitsSystemWindows="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp"
      android:text="@string/wallpaper_description"
      android:textAppearance="?android:attr/textAppearanceLarge" />
    <TextView
      android:id="@+id/location_current"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/location_unset"
      android:textAppearance="?android:attr/textAppearanceMedium" />
    <TextView
      android:id="@+id/location_timezone_help"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/location_timezone_help" />
    <Button
      android:id="@+id/use_current_location"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/use_current_location" />
    <Button
      android:id="@+id/refresh_location"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/refresh_location" />
    <EditText
      android:id="@+id/latitude_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/latitude_hint"
      android:importantForAutofill="no"
      android:inputType="numberDecimal|numberSigned" />
    <EditText
      android:id="@+id/longitude_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/longitude_hint"
      android:importantForAutofill="no"
      android:inputType="numberDecimal|numberSigned" />
    <Button
      android:id="@+id/select_timezone"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/choose_timezone_title" />
    <Button
      android:id="@+id/save_location"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/save_location" />
    <CheckBox
      android:id="@+id/zodiac_ring"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/zodiac_ring" />
    <CheckBox
      android:id="@+id/sun_layer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/sun_layer" />
    <CheckBox
      android:id="@+id/moon_layer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/moon_layer" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/dial_location_help" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/appearance_title"
      android:textAppearance="?android:attr/textAppearanceMedium" />
    <RadioGroup
      android:id="@+id/appearance_group"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <RadioButton
        android:id="@+id/appearance_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/appearance_system" />
      <RadioButton
        android:id="@+id/appearance_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/appearance_light" />
      <RadioButton
        android:id="@+id/appearance_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/appearance_dark" />
    </RadioGroup>
    <TextView
      android:id="@+id/display_size_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/display_size"
      android:text="@string/display_size" />
    <SeekBar
      android:id="@+id/display_size"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp" />
    <TextView
      android:id="@+id/display_horizontal_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/display_horizontal"
      android:text="@string/display_horizontal" />
    <SeekBar
      android:id="@+id/display_horizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp" />
    <TextView
      android:id="@+id/display_vertical_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/display_vertical"
      android:text="@string/display_vertical" />
    <SeekBar
      android:id="@+id/display_vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp" />
    <TextView
      android:id="@+id/display_brightness_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:labelFor="@+id/display_brightness"
      android:text="@string/display_brightness" />
    <SeekBar
      android:id="@+id/display_brightness"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp" />
    <Button
      android:id="@+id/reset_display"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/reset_display" />
    <Button
      android:id="@+id/open_preview"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/open_preview" />
  </LinearLayout>
</ScrollView>
