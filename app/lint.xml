<?xml version="1.0" encoding="utf-8"?>
<lint>
  <!-- Keep the explicit Gradle and AGP pins; review toolchain upgrades separately. -->
  <issue id="AndroidGradlePluginVersion">
    <ignore path="../gradle/wrapper/gradle-wrapper.properties" />
    <ignore path="../gradle/libs.versions.toml" />
  </issue>

  <!-- Keep dependency upgrades deliberate, not on CI's clock. These two checks live-query
       Maven Central on every run, so a "newer version available" result depends on the
       network's current state rather than the pinned, reproducible toolchain. Dependencies
       are reviewed and bumped explicitly (Robolectric 4.17 here) instead of erroring the
       hermetic gate the moment a later release ships. -->
  <issue id="NewerVersionAvailable" severity="ignore" />
  <issue id="GradleDependency" severity="ignore" />
</lint>
